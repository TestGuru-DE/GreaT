  "decisionTableHelp": {
    "title": "📋 Decision Table – Help",
    "close": "Close",
    "back": "← Back",
    "next": "Next →",
    "done": "Got it ✓",
    "step1": {
      "title": "Step 1: Create categories",
      "content": "Create at least <strong>one cause</strong> and <strong>one effect</strong>.",
      "cause": "Cause (Condition): A condition that can occur (e.g. \"User is logged in\")",
      "effect": "Effect (Action): An action or result (e.g. \"Access granted\")",
      "warning": "⚠️ The \"Decision Table\" button is only active when BOTH types exist!"
    },
    "step2": {
      "title": "Step 2: Assign values (optional)",
      "content": "By default, the table uses <strong>Y/N</strong> (Yes/No) for causes.",
      "customValues": "You can also create your own values for causes (Extended Entry), e.g.:",
      "textMode": "For effects, you can activate <strong>text mode</strong> to enter free-text values."
    },
    "step3": {
      "title": "Step 3: Generate table",
      "content": "Click the <strong>\"📋 Decision Table\"</strong> button:",
      "firstClick": "First click: Activates the mode",
      "secondClick": "Second click (\"⚡ Generate\"): Creates the table",
      "info": "The table shows all possible combinations of your causes (2^N rules).",
      "tip": "💡 With 3 causes = 2³ = 8 rules. With 5 causes = 2⁵ = 32 rules."
    },
    "step4": {
      "title": "Step 4: Fill in effects",
      "content": "For each rule, enter which effects occur:",
      "x": "<strong>X</strong> = This effect occurs",
      "dash": "<strong>—</strong> = This effect does not occur (Don't Care)",
      "dot": "<strong>·</strong> = Not yet defined",
      "textMode": "In <strong>text mode</strong> you can enter free-text values instead of X/—."
    },
    "step5": {
      "title": "Step 5: Add constraints",
      "content": "Constraints describe logical relationships between causes or effects:",
      "exclusive": "<strong>E (Exclusive):</strong> At most one cause can be true",
      "oneOnlyOne": "<strong>O (One-and-Only-One):</strong> Exactly one cause must be true",
      "inclusive": "<strong>I (Inclusive):</strong> At least one cause must be true",
      "requires": "<strong>R (Requires):</strong> If cause A is true, then cause B too",
      "mask": "<strong>M (Mask):</strong> If effect A is active, then effect B is blocked"
    },
    "step6": {
      "title": "Step 6: Check and optimize",
      "content": "Use the <strong>\"📦 Collapse\"</strong> and <strong>\"🔍 Check\"</strong> buttons:",
      "collapse": "<strong>Collapse:</strong> Automatically merges redundant rules (Collapsing)",
      "check": "<strong>Check:</strong> Shows whether the table is complete, has contradictions or gaps",
      "legend": "✅ Green = Complete | 🟡 Yellow = Overlaps | 🔴 Red = Gaps"
    }
  },
