# G.R.E.A.T. Konfiguration
# Kopiere diese Datei nach .env und passe Werte an.
# Commit diese Datei (als .env.example) ins Repo, nicht .env selbst!

# Backend-Port (default: 8000)
# Nutze z.B. GREAT_PORT=9000 vor Start.bat/Start.sh
GREAT_PORT=8000

# Backend-Host (default: 0.0.0.0 = alle Interfaces)
# Ändere zu "127.0.0.1" wenn nur lokal erreichbar sein soll
GREAT_HOST=0.0.0.0

# Datenbank (default: SQLite lokal)
# Für lokale Entwicklung (Standard):
# DATABASE_URL=sqlite:///./great.db

# Für PostgreSQL (Produktion):
# DATABASE_URL=postgresql://user:password@localhost/great

# Für MySQL:
# DATABASE_URL=mysql+pymysql://user:password@localhost/great

# REQ-4009: Logging-Konfiguration
# Log-Level: DEBUG, INFO (default), WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log-Format: text (default, lesbar) oder json (Produktion)
# LOG_FORMAT=json

# REQ-4018: Maximale Anzahl Testfaelle pro Generierung (Default: 1000)
# Server-seitiger Fallback, falls kein 'limit' im Request mitgeschickt wird
# (z. B. direkte API-Aufrufe ohne Frontend). Das Frontend-Setting im
# Karteireiter "Einstellungen" wirkt sofort ueber den Request-Parameter.
# GREAT_MAX_TESTCASES=1000

# B-25: JWT-Secrets (in Production zwingend setzen!)
# Wenn nicht gesetzt, wird eine jwt_secrets.json neben der DB-Datei erzeugt.
# JWT_SECRET_KEY=
# JWT_REFRESH_SECRET_KEY=

# B-26: Cookie Secure-Flag (True wenn HTTPS, False fuer lokale Entwicklung)
# GREAT_COOKIE_SECURE=false

# REQ-6001/B-03: Grenzen fuer die Generierung
# Maximales kartesisches Produkt bei "Alle Kombinationen" (Default: 100000)
# GREAT_MAX_COMBINATIONS=100000
# Maximale Anzahl t-Tupel bei Pairwise/T-Wise (Default: 1000000)
# GREAT_MAX_TUPLES=1000000
# Zeitbudget pro Generierung in Sekunden (Default: 60)
# GREAT_GENERATION_TIMEOUT_S=60

# REQ-4011: Maximale Groesse einer Sicherung beim Wiederherstellen in MB (Default: 50)
# GREAT_MAX_BACKUP_MB=50

# REQ-6012: API-Tokens – Anfragen pro Minute und Token (Default: 600)
# GREAT_TOKEN_RATE_LIMIT=600

# Hinter einem Reverse-Proxy: X-Forwarded-For fuer Rate-Limits auswerten (Default: false)
# GREAT_TRUST_PROXY_HEADERS=false

# Swagger-UI/OpenAPI nur nach Anmeldung (Default: true; nur fuer Entwicklung abschalten)
# GREAT_DOCS_AUTH=true

# Erlaubte Urspruenge fuer CORS, kommagetrennt
# CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# JWT-Einstellungen
# JWT_ALGORITHM=HS256
# Lebensdauer des Zugriffstokens in Minuten (Default: 15)
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Lebensdauer des Refresh-Tokens in Tagen (Default: 7)
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
